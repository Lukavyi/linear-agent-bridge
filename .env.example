# Linear bridge — environment schema.
#
# The bridge deploys twice from this one codebase, switched by BACKEND.
# @Clawd usually runs as an OpenClaw plugin; the standalone server (server.ts)
# is what the @Hermes Railway service runs.

# ── Backend selector ────────────────────────────────────────────────────────
# openclaw | hermes  (defaults to openclaw when unset)
BACKEND=hermes

# ── Hermes backend (only consulted when BACKEND=hermes) ─────────────────────
# Private Railway address of the Hermes api_server (public networking disabled).
HERMES_URL=http://hermes.railway.internal:8000
# Must equal the Hermes service's API_SERVER_KEY.
HERMES_API_KEY=

# ── Standalone server ───────────────────────────────────────────────────────
# Railway injects PORT automatically; defaults to 8080 locally.
PORT=8080
# Set to 1 to emit debug logs (e.g. ignored Hermes SSE event types).
LINEAR_DEBUG=0

# ── Linear integration (per-persona OAuth app, actor=app) ───────────────────
LINEAR_WEBHOOK_SECRET=
LINEAR_API_KEY=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=
# Path on the mounted Railway Volume where OAuth tokens are persisted.
LINEAR_TOKEN_STORE_PATH=/data/linear-tokens.json
AGENT_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# EXTERNAL_URL_BASE=
# EXTERNAL_URL_LABEL=
# REPO_BY_TEAM={"TEAM_KEY":"/path/to/repo"}
# REPO_BY_PROJECT={"PROJECT_KEY":"/path/to/repo"}
